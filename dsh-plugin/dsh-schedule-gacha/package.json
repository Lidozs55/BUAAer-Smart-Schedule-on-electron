{
  "name": "@lidozs55/dsh-schedule-gacha",
  "version": "0.1.0",
  "description": "Gacha preview tracker: pulls formatted version and preview-stream plans for six games from the gacha-calendar service and keeps one preview entry per game.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@lidozs55/dsh-schedule"
      ]
    }
  }
}
