{
  "name": "intelligent-calendar-for-buaaer",
  "version": "1.0.0",
  "description": "智能日历应用 - 北航学生专用",
  "main": "electron/main.js",
  "author": "BUAAer",
  "license": "MIT",
  "scripts": {
    "electron:dev": "concurrently --kill-others \"npm run dev:frontend\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build:frontend && npm run build:backend && electron-builder --win --x64",
    "electron:build:portable": "npm run build:frontend && npm run build:backend && electron-builder --win portable --x64",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && python app.py",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && python build_nuitka.py",
    "start:cpolar": "cd cpolar && cpolar.exe http 5000",
    "install:all": "npm install && cd frontend && npm install",
    "postinstall": "electron-builder install-app-deps",
    "verify:optimization": "node verify-optimization.js"
  },
  "build": {
    "appId": "com.buaaer.intelligent-calendar",
    "productName": "BUAAerSmartSchedule",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "frontend/public/icons/**/*",
      "package.json",
      "!**/*.{map,ts,tsx,md,markdown}",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme,HISTORY.md,CONTRIBUTING.md,LICENSE}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples,coverage,docs,doc}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/node_modules/*/*.md",
      "!**/node_modules/*/.bin",
      "!**/node_modules/*/*.ts",
      "!**/node_modules/*/*.tsx",
      "!**/node_modules/*/*.json",
      "!**/node_modules/*/.npmignore",
      "!**/node_modules/*/.travis.yml",
      "!**/node_modules/*/.eslintrc*",
      "!**/node_modules/*/.babelrc*",
      "!**/node_modules/*/.gitignore",
      "!**/node_modules/*/*.flow",
      "!**/node_modules/*/.editorconfig",
      "!**/node_modules/*/.npmignore",
      "!**/node_modules/*/.eslintignore",
      "!**/node_modules/*/.prettierrc*",
      "!**/node_modules/*/.stylelintrc*",
      "!**/node_modules/*/.browserslistrc",
      "!**/node_modules/*/.nvmrc",
      "!**/node_modules/*/.yarn-integrity",
      "!**/node_modules/*/.yarn-metadata.json",
      "!**/node_modules/*/.yarn-tarball",
      "!**/node_modules/*/.DS_Store",
      "!**/node_modules/*/*.log",
      "!**/node_modules/*/.npm",
      "!**/node_modules/*/.yarn",
      "!**/node_modules/*/.cache",
      "!**/node_modules/*/.tmp",
      "!**/node_modules/*/.temp",
      "!**/node_modules/*/.git",
      "!**/node_modules/*/.svn",
      "!**/node_modules/*/.hg",
      "!**/node_modules/*/.idea",
      "!**/node_modules/*/.vscode"
    ],
    "extraResources": [
      {
        "from": "backend/dist/backend_server.exe",
        "to": "backend/backend_server.exe"
      },
      {
        "from": "backend/.env",
        "to": "backend/.env",
        "filter": ["**/*"]
      },
      {
        "from": "cpolar",
        "to": "cpolar",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "frontend/public/icons/icon-256x256.png",
      "requestedExecutionLevel": "asInvoker",
      "forceCodeSigning": false,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "asarUnpack": ["**/*.node", "frontend/dist/**/*", "backend/**/*"]
  },
  "dependencies": {
    "axios": "^1.6.7",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^36.0.0",
    "electron-builder": "^26.8.1",
    "wait-on": "^8.0.2"
  }
}
