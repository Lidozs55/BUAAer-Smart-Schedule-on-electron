# LLM 配置
# 支持的 platform: dashscope(阿里云百炼), openai(OpenAI 兼容接口)
LLM_PLATFORM=dashscope

# API Key
# 阿里云百炼：https://dashscope.console.aliyun.com/apiKey
# DeepSeek: https://platform.deepseek.com/api_keys
# OpenAI: https://platform.openai.com/api-keys
LLM_API_KEY=your_api_key_here

# 模型名称（可选）
# dashscope 平台示例：qwen-plus-2025-12-01, qwen-turbo, qwen-max
# openai 平台示例：deepseek-chat, gpt-3.5-turbo, gpt-4
LLM_MODEL=

# Base URL（可选，仅 openai 平台需要）
# DeepSeek: https://api.deepseek.com
# OpenAI: https://api.openai.com/v1
# 如果使用 dashscope 平台，留空即可
LLM_BASE_URL=

# Flask 配置
SECRET_KEY=your-secret-key-here

# 数据库配置（可选）
# DATABASE_URL=sqlite:///instance/app.db
